---
import '../styles/global.css';
import { layoutStyles as css } from '../styles/layout.ts';
interface Props { title: string; subtitle?: string; active?: string; bare?: boolean }
const { title, subtitle = '', active = '', bare = false } = Astro.props;
const links = [['/', 'Home'], ['/simulator', 'Shor simulator'], ['/encrypt', 'Encrypt a file'], ['/attack', 'Attack demo']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Quantum Threats</title>
  </head>
  <body>
    <nav class={css.nav}>
      <span class={css.brand}>Quantum Threats</span>
      {links.map(([href, label]) => (
        <a href={href} class:list={[css.link, active === href ? css.linkOn : css.linkOff]}>{label}</a>
      ))}
    </nav>
    <div class={css.wrap}>
      {!bare && <header class="mb-[18px]"><h1 class={css.title}>{title}</h1>{subtitle && <p class={css.subtitle}>{subtitle}</p>}</header>}
      <slot />
    </div>
  </body>
</html>

---
import '../styles/global.css';
interface Props { title: string; subtitle?: string; active?: string; bare?: boolean }
const { title, subtitle = '', active = '', bare = false } = Astro.props;
const links = [['/', 'Home'], ['/simulator', 'Shor simulator'], ['/encrypt', 'Encrypt a file'], ['/attack', 'Attack demo']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Quantum Threats</title>
  </head>
  <body>
    <nav class="flex flex-wrap items-center gap-1 px-8 py-3 bg-panel border-b border-line">
      <span class="font-bold mr-[18px]">Quantum Threats</span>
      {links.map(([href, label]) => (
        <a href={href} class:list={['text-[15px] no-underline px-3 py-1.5 rounded-lg font-medium', active === href ? 'text-accent bg-accent-soft' : 'text-muted hover:text-ink hover:bg-panel2']}>{label}</a>
      ))}
    </nav>
    <div class="max-w-[1500px] mx-auto px-8 pt-7 pb-16">
      {!bare && <header class="mb-[18px]"><h1 class="m-0 mb-1 text-[28px] font-bold tracking-[-.01em]">{title}</h1>{subtitle && <p class="m-0 text-muted">{subtitle}</p>}</header>}
      <slot />
    </div>
  </body>
</html>
